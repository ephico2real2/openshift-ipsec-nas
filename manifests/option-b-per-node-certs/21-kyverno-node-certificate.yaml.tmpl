# Kyverno 1.19 and later (policies.kyverno.io/v1). The legacy ClusterPolicy is in kyverno-legacy/.
apiVersion: policies.kyverno.io/v1
kind: GeneratingPolicy
metadata:
  name: ipsec-node-certificate
spec:
  evaluation:
    generateExisting:
      enabled: true          # nodes that exist before the policy get a Certificate too
    synchronize:
      enabled: true          # the Certificate is deleted when the Node is deleted
  matchConstraints:
    resourceRules:
    - apiGroups: [""]
      apiVersions: ["v1"]
      operations: ["CREATE", "UPDATE"]
      resources: ["nodes"]
    objectSelector:
      matchLabels:
        node-role.kubernetes.io/worker: ""
      # exclude-nodes:begin
      # Nodes with ANY of these labels are left out, even if they also match the labels above.
      matchExpressions:
      - key: node-role.kubernetes.io/control-plane
        operator: DoesNotExist
      - key: node-role.kubernetes.io/master
        operator: DoesNotExist
      - key: node-role.kubernetes.io/ingress
        operator: DoesNotExist
      # exclude-nodes:end
  generate:
  - template:
      interpolate: cel
      value: |
        apiVersion: cert-manager.io/v1
        kind: Certificate
        metadata:
          name: ipsec-(( object.metadata.name ))
          namespace: kcs-ipsec
        spec:
          secretName: ipsec-cert-(( object.metadata.name ))
          commonName: (( object.metadata.name )).${NODE_DOMAIN}
          dnsNames:
          - (( object.metadata.name )).${NODE_DOMAIN}
          duration: 8760h
          renewBefore: 720h
          privateKey:
            algorithm: RSA
            size: 3072
            rotationPolicy: Always
          usages:
          - digital signature
          - key encipherment
          - server auth
          - client auth
          issuerRef:
            group: cert-manager.io
            kind: ClusterIssuer
            name: ${CLUSTER_ISSUER}
# In the Certificate above: the common name has at most 64 characters and must not start with ovs_;
# the DNS name must equal the NNCP "left" value; duration 1 year (the CA may override it), renewed
# 30 days before expiry, with a new RSA key every time (the NNCP uses leftrsasigkey: '%cert');
# the issuer is the existing enterprise CA ClusterIssuer.
