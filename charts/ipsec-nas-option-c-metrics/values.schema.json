{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "nodeSelector": {"type": "object", "additionalProperties": {"type": ["string", "null"]}},
    "excludeNodeLabels": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "tolerations": {"type": "array"},
    "images": {
      "type": "object", "additionalProperties": false, "required": ["cli", "python"],
      "properties": {"cli": {"type": "string", "minLength": 1}, "python": {"type": "string", "minLength": 1}}
    },
    "serviceAccount": {
      "type": "object", "additionalProperties": false, "required": ["name"],
      "properties": {"name": {"type": "string", "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"}}
    },
    "scc": {"type": "object", "additionalProperties": false, "properties": {"bind": {"type": "boolean"}}},
    "metrics": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "serviceMonitor": {"type": "boolean"},
        "prometheusRule": {"type": "boolean"},
        "grafanaDashboard": {"type": "boolean"},
        "persesDashboard": {
          "type": "object", "additionalProperties": false,
          "properties": {"enabled": {"type": "boolean"}, "thanosURL": {"type": "string", "pattern": "^https://"}}
        }
      }
    }
  }
}
